    "axios": "1.19.0",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.7",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
