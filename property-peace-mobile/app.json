{
  "expo": {
    "name": "Property Peace",
    "slug": "property-peace-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#082f58"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.propertypeace.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#082f58"
      },
      "package": "com.propertypeace.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "propertypeace",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Property Peace account on this device."
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store"
    ]
  }
}
