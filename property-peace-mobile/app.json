{
  "expo": {
    "name": "Property Peace",
    "slug": "property-peace-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#082f58"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.propertypeace.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos or videos to document maintenance, property inspections, repair completion, or expense receipts.",
        "NSPhotoLibraryUsageDescription": "Choose photos or videos to document maintenance, property inspections, repair completion, or expense receipts."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#082f58"
      },
      "package": "com.propertypeace.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "propertypeace",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Property Peace account on this device."
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos or videos to document maintenance, property inspections, repair completion, or expense receipts.",
          "cameraPermission": "Take photos or videos to document maintenance, property inspections, repair completion, or expense receipts.",
          "microphonePermission": "Record audio while capturing a maintenance or property-inspection video."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
