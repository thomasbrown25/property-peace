{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:5001/",
        "EXPO_PUBLIC_SIGNALR_URL": "http://127.0.0.1:5001/notificationHub"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-dev.propertypeace.io/",
        "EXPO_PUBLIC_SIGNALR_URL": "https://api-dev.propertypeace.io/notificationHub"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.propertypeace.io/",
        "EXPO_PUBLIC_SIGNALR_URL": "https://api.propertypeace.io/notificationHub"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
