{
  "name": "property-peace-marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate-sitemap && npm run generate-rss && next build",
    "start": "next start",
    "out": "npx serve@latest out",
    "lint": "eslint",
    "test:footer-navigation": "node --test scripts/footer-navigation.contract.test.mjs",
    "test:visual-theme": "npm run build && node --test scripts/visual-theme.contract.test.mjs",
    "test:hero-background": "npm run build && node --test scripts/hero-background.contract.test.mjs",
    "test:marketing-claims": "node scripts/check-marketing-claims.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "generate-rss": "node scripts/generate-rss.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "framer-motion": "^12.29.2",
    "isotope-layout": "^3.0.6",
    "next": "16.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  }
}
