{
  "name": "property-peace-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "property-peace-app",
      "shared"
    ],
    "nohoist": [
      "property-peace-app/**"
    ]
  },
  "scripts": {
    "install:all": "npm install",
    "build:web": "cd property-peace-app && npm run build",
    "build:mobile": "cd brownstone-hub-mobile && npm install && npm run build",
    "install-githooks": "node scripts/install-githooks.js"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.45.1"
  }
}
